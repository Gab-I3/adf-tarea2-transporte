{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(RutaHistoricaId = iif(\r",
				"    startsWith(upper(trim(RutaHistoricaId)), 'RH-'),\r",
				"    upper(trim(RutaHistoricaId)),\r",
				"    concat(\r",
				"        'R-',\r",
				"        lpad(\r",
				"            regexReplace(trim(RutaHistoricaId), `[^0-9]`, ''),\r",
				"            2,\r",
				"            '0'\r",
				"        )\r",
				"    )\r",
				"),",
				"          CodigoRuta = concat(\r",
				"    'R-',\r",
				"    lpad(\r",
				"        regexReplace(trim(RutaHistoricaId), `[^0-9]`, ''),\r",
				"        2,\r",
				"        '0'\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(VigenciaDesde = iif(\r",
				"    isDate(trim(VigenciaDesde), 'dd/MM/yyyy'),\r",
				"    toDate(trim(VigenciaDesde), 'dd/MM/yyyy'),\r",
				"    iif(\r",
				"        isDate(trim(VigenciaDesde), 'yyyy-MM-dd'),\r",
				"        toDate(trim(VigenciaDesde), 'yyyy-MM-dd'),\r",
				"        toDate(null())\r",
				"    )\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    isDate(trim(VigenciaHasta), 'dd/MM/yyyy'),\r",
				"    toDate(trim(VigenciaHasta), 'dd/MM/yyyy'),\r",
				"    iif(\r",
				"        isDate(trim(VigenciaHasta), 'yyyy-MM-dd'),\r",
				"        toDate(trim(VigenciaHasta), 'yyyy-MM-dd'),\r",
				"        toDate(null())\r",
				"    )\r",
				")) ~> derivedColumn2",
				"source1 derive(NombreRuta = upper(trim(NombreRuta)),",
				"          Origen = upper(trim(Origen)),",
				"          Destino = upper(trim(Destino)),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn3",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}